##################################CAIRN##################################
entity = {
	name = "NS_cairn_entity"
	locator = { name = "root"		position = { 0 1 0 } rotation = { 180 0 0 } }

	default_state = idle

	attach = { "root" 				= "NS_cairn_black_entity" }
	attach = { "root" 				= "NS_cairn_dark_entity" }
	attach = { "root" 				= "NS_cairn_medium_entity" }
	attach = { "root" 				= "NS_cairn_green_entity" }

	scale = 1.0
}

entity = {
	name = "NS_cairn_black_entity"
	pdxmesh = "NS_cairn_black_mesh"
	scale = 1.0
}

entity = {
	name = "NS_cairn_dark_entity"
	pdxmesh = "NS_cairn_dark_mesh"
	scale = 1.0
}

entity = {
	name = "NS_cairn_medium_entity"
	pdxmesh = "NS_cairn_medium_mesh"
	scale = 1.0
}

entity = {
	name = "NS_cairn_green_entity"
	pdxmesh = "NS_cairn_green_mesh"
	scale = 1.0
}
