<?xml version="1.0" encoding="utf-8"?>
<language>
    <entry name="Drukhari/SpiritProbeDescription"
           value="Grants additional feel no pain damage reduction to adjacent Drukhari infantry units at and above level 3."/>
    <entry name="Orks/CyborkImplantsDescription"
           value="Permanently increases the damage and damage reduction of the target allied Ork infantry or monstrous creature unit."/>
    <entry name="SistersOfBattle/SaintlyBlessingsDescription"
           value="Increases the damage reduction."/>
    <entry name="Tau/NovaElectromagneticShockwaveDescription"
           value="Sacrifices hitpoints to do a special attack that targets adjacent enemies."/>
	<entry name="MisfortuneDescription" value="Increases the damage dealt by Astra Militarum units to the target enemy unit."/>
</language>
