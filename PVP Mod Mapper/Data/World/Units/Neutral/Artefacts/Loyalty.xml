<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/Neutral/Artefact"
				material="Units/Neutral/Artefact"
				scale="0.75 0.75 0.75"
				idleAnimation="Units/Neutral/ArtefactIdle"
				idleAnimationCount="1"
				idleContinuously="1"
				explosionsBone="Top"/>
	</model>
	<group size="1"/>
	<modifiers>
		<modifier visible="0">
			<effects>
				<hitpointsMax base="1"/>
				<levelMax base="0"/>
				<moraleMax base="0"/>
				<movementMax max="0"/>
				<sight base="1"/>
			</effects>
		</modifier>
	</modifiers>
	<actions>
		<genericUnitAbility icon="Units/Neutral/Artefacts/Loyalty"
				name="Artefacts/Loyalty"
				passive="1">
			<model>
				<action sound="Actions/PowerUpArtefact"/>
			</model>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Artefacts/Loyalty"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</genericUnitAbility>
		<!-- Artefacts/Loyalty does not exist as an action. I don't know. I don't care. -->
		<tactic icon="Units/Neutral/Artefacts/Loyalty"
				name="Artefacts/Hitpoints"
				passive="1"
				visible="0"> <!-- Hide it. Otherwise the artefact will look like it gives two buffs. Whereas this "tactic" thing is just a tool for us. -->
			<playerModifiers>
				<modifier>
					<effects>
						<addTrait name="Artefacts/LoyaltyMarker"/>
					</effects>
				</modifier>
			</playerModifiers>
		</tactic>
	</actions>
	<traits>
		<trait name="Artefact"/>
		<trait name="Invulnerable"/>
	</traits>
</unit>
